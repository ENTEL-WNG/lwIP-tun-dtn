FROM debian:bookworm-slim
 
# Install build tools + Python dev headers (needed for python3-config --embed)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpcap-dev \
    iproute2 \
    iptables \
    procps \
    iputils-ping \
    tcpdump \ 
    python3-dev \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
 
# Set working directory to match the mounted project
WORKDIR /root/
 
# Copy everything from the project root (context must be set to ../ )
COPY . .
 
# Default: drop into an interactive shell so you can build/run manually
CMD ["/bin/bash"]
 
# Build & start:
#  docker compose -f tests/docker-compose-test.yml up -d --build
#  docker compose -f tests/docker-compose-test.yml exec test bash
#  docker compose -f docker-compose-test.yml down      