FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    libpcap-dev \
    libpcap0.8 \
    python3-dev \
    iproute2 \
    iptables \
    procps \
    iputils-ping \
    tcpdump \
    netcat-openbsd \
    # Python runtime (tomllib is stdlib >= 3.11; Debian bookworm ships 3.11)
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /repo

# CONFIG_PATH is overridden per-service in docker-compose.yml.
ENV CONFIG_PATH=/repo/node.toml

# init_node.py reads the TOML at CONFIG_PATH, applies sysctl/ip/ip6tables/
# routing rules, runs `make -C /repo` to build lwip_tun, then either execs
# /repo/lwip_tun (DTN nodes) or sleeps (regular).
ENTRYPOINT ["python3", "/repo/init_node.py"]
CMD ["${CONFIG_PATH}"]
